# GrowthNest Frontend — Environment Variables
# Copy this file to .env and fill in the real values.
# NEVER commit the actual .env file to version control.
# In Vite, all env vars exposed to the browser must be prefixed with VITE_

# ─── API ───────────────────────────────────────────────────────────────────────
# The base URL of your deployed backend (no trailing slash)
# Required in every environment; there is no localhost fallback in the client.
VITE_API_URL="https://your-backend-domain.onrender.com"
