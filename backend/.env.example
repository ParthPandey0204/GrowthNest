# GrowthNest Backend — Environment Variables
# Copy this file to .env and fill in the real values.
# NEVER commit the actual .env file to version control.

# ─── Database ──────────────────────────────────────────────────────────────────
# Full PostgreSQL connection string (Neon, Supabase, Railway, etc.)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB_NAME?schema=public"

# ─── Application ───────────────────────────────────────────────────────────────
NODE_ENV="production"             # "development" | "production"
PORT=5000                         # Port the Express server listens on

# ─── Security ──────────────────────────────────────────────────────────────────
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# ─── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (no trailing slash)
# Example: "https://growthnest.vercel.app,https://www.growthnest.com"
FRONTEND_URL="https://your-vercel-domain.vercel.app"

# ─── Cloudinary ────────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"
